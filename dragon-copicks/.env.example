# Dragon Co Picks — copy to .env and fill in. NEVER commit your real .env.

# ── Telegram (required to post) ──
# Create a bot with @BotFather, then add it to your channel as an admin.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Public channel: @dragoncopicks   |   Private channel: -1001234567890
TELEGRAM_CHAT_ID=@dragoncopicks

# ── Claude / Anthropic (required for the intelligence) ──
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# DRAGON_MODEL=claude-opus-4-8
# DRAGON_EFFORT=high            # low | medium | high | xhigh | max
# DRAGON_WEB_SEARCH=1           # 0 to disable web research (knowledge-only)

# ── Picks ──
# DRAGON_LEAGUES=               # blank = all leagues; or e.g. NBA,NFL,MLB
# DRAGON_SLIP_SIZE=6            # how many picks to post
# DRAGON_FINALISTS=25           # how many lines Claude reasons over
# DRAGON_MIN_CONFIDENCE=0.58    # min confidence to include a pick
# DRAGON_INCLUDE_PROMOS=0       # 1 to allow demon/goblin promo lines

# ── Fetching / running ──
# DRAGON_FIXTURE=               # path to a saved projections JSON (skips network)
# DRAGON_DRY_RUN=0              # 1 = build + print the slip, don't post
# DRAGON_CHROMIUM_PATH=         # explicit Chromium binary, if Playwright can't find one
